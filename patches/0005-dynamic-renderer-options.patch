+static void set_option_visible(const char *key, bool visible)
+{
+    struct retro_core_option_display option_display;
+    option_display.key = key;
+    option_display.visible = visible;
+    environ_cb(RETRO_ENVIRONMENT_SET_CORE_OPTIONS_DISPLAY, &option_display);
+}
+
+static const char *resolve_default_gfx_plugin(void)
+{
+#ifdef HAVE_PARALLEL
+    return "parallel";
+#elif defined(HAVE_GLIDEN64)
+    return "gliden64";
+#elif defined(HAVE_GLIDE64)
+    return "glide64";
+#elif defined(HAVE_RICE)
+    return "rice";
+#elif defined(HAVE_GLN64)
+    return "gln64";
+#else
+    return "angrylion";
+#endif
+}
+
+static bool is_known_gfx_plugin(const char *plugin)
+{
+    if (!plugin)
+        return false;
+
+    return !strcmp(plugin, "glide64") ||
+           !strcmp(plugin, "rice") ||
+           !strcmp(plugin, "gln64") ||
+           !strcmp(plugin, "gliden64") ||
+           !strcmp(plugin, "angrylion") ||
+           !strcmp(plugin, "parallel");
+}
+
+static const char *get_gfx_plugin_prefix(const char *plugin)
+{
+    if (!plugin)
+        return NULL;
+    if (!strcmp(plugin, "angrylion"))
+        return "Angrylion: ";
+    if (!strcmp(plugin, "parallel"))
+        return "ParaLLEl: ";
+    if (!strcmp(plugin, "glide64"))
+        return "Glide64: ";
+    if (!strcmp(plugin, "gliden64"))
+        return "GLideN64: ";
+    if (!strcmp(plugin, "rice"))
+        return "Rice: ";
+    return NULL;
+}
