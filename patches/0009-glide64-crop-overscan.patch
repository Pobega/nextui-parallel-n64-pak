+static uint32_t clip_last[4] = { ~0u, ~0u, ~0u, ~0u };
+
+static int clamp_int(int v, int lo, int hi)
+{
+   if (v < lo)
+      return lo;
+   if (v > hi)
+      return hi;
+   return v;
+}
+
+void glitch64_set_overscan(int lines, int mode)
+{
+   int clamped = clamp_int(lines, 0, GLITCH64_OVERSCAN_MAX_LINES);
+   int normalized_mode = (mode == GLITCH64_OVERSCAN_VERTICAL)
+      ? GLITCH64_OVERSCAN_VERTICAL
+      : GLITCH64_OVERSCAN_UNIFORM;
+
+   if (clamped == overscan_lines && normalized_mode == overscan_mode)
+      return;
+
+   overscan_lines = clamped;
+   overscan_mode  = normalized_mode;
+   clip_last[0] = clip_last[1] = clip_last[2] = clip_last[3] = ~0u;
+   g_gdp.flags |= UPDATE_SCISSOR;
+   glitch64_combiner_invalidate_overscan();
+}
+
+void glitch64_get_vertex_offset(float *cx, float *cy, float *rx, float *ry)
+{
+   float half_w = (float)width * 0.5f;
+   float half_h = (float)height * 0.5f;
+   float crop_y_frac = (float)overscan_lines / GLITCH64_OVERSCAN_REF_HEIGHT;
+   float crop_x_frac = (overscan_mode == GLITCH64_OVERSCAN_UNIFORM) ? crop_y_frac : 0.0f;
+
+   *cx = half_w;
+   *cy = half_h;
+   *rx = half_w * (1.0f - 2.0f * crop_x_frac);
+   *ry = half_h * (1.0f - 2.0f * crop_y_frac);
+}
+
+float glitch64_get_overscan_aspect_scale(void)
+{
+   if (overscan_lines <= 0 || overscan_mode == GLITCH64_OVERSCAN_UNIFORM)
+      return 1.0f;
+   return GLITCH64_OVERSCAN_REF_HEIGHT /
+      (GLITCH64_OVERSCAN_REF_HEIGHT - 2.0f * (float)overscan_lines);
+}
