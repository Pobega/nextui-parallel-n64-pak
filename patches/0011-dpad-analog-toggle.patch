diff --git a/libretro/libretro.c b/libretro/libretro.c
index 1f2ebe6f..d8905bc4 100644
--- a/libretro/libretro.c
+++ b/libretro/libretro.c
@@ -296,6 +296,7 @@ int astick_sensitivity                    = 100;
 #define DPAD_ANALOG_RAMP_MEDIUM_MS  220
 #define DPAD_ANALOG_RAMP_SLOW_MS    320
 int dpad_to_analog_mode                   = DPAD_ANALOG_DISABLED;
+static int dpad_last_active_mode          = DPAD_ANALOG_ONLY;
 int dpad_analog_ramp_ms                   = DPAD_ANALOG_RAMP_MEDIUM_MS;
 float dpad_analog_max_frac                = 1.0f;
 static bool dpad_analog_shown             = true;
@@ -867,6 +868,49 @@ static bool set_variable_visibility(void)
     return true;
 }
 
+void libretro_toggle_dpad_to_analog(void)
+{
+    const char *next_value;
+    const char *log_label;
+    struct retro_variable var;
+    struct retro_message msg;
+
+    if (!environ_cb)
+        return;
+
+    if (dpad_to_analog_mode == DPAD_ANALOG_DISABLED)
+    {
+        dpad_to_analog_mode = dpad_last_active_mode;
+        if (dpad_to_analog_mode == DPAD_ANALOG_BOTH)
+        {
+            next_value = "both";
+            log_label = "D-Pad: Control Stick + D-Pad";
+        }
+        else
+        {
+            dpad_to_analog_mode = DPAD_ANALOG_ONLY;
+            next_value = "analog";
+            log_label = "D-Pad: Control Stick";
+        }
+    }
+    else
+    {
+        dpad_last_active_mode = dpad_to_analog_mode;
+        dpad_to_analog_mode = DPAD_ANALOG_DISABLED;
+        next_value = "disabled";
+        log_label = "D-Pad: Digital";
+    }
+
+    var.key = CORE_NAME "-dpad-to-analog";
+    var.value = next_value;
+    environ_cb(RETRO_ENVIRONMENT_SET_VARIABLE, &var);
+    set_variable_visibility();
+
+    msg.msg = log_label;
+    msg.frames = 120;
+    environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE, &msg);
+}
+
 static void setup_variables(void)
 {
    bool categoriesSupported = false;
@@ -3206,6 +3250,8 @@ void update_variables(bool startup)
       else if (!strcmp(var.value, "both"))
          dpad_to_analog_mode = DPAD_ANALOG_BOTH;
    }
+   if (dpad_to_analog_mode != DPAD_ANALOG_DISABLED)
+      dpad_last_active_mode = dpad_to_analog_mode;
 
    var.key = CORE_NAME "-dpad-to-analog-ramp";
    var.value = NULL;
