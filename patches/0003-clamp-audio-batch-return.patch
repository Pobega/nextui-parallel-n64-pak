diff --git a/mupen64plus-core/src/plugin/audio_libretro/audio_backend_libretro.c b/mupen64plus-core/src/plugin/audio_libretro/audio_backend_libretro.c
--- a/mupen64plus-core/src/plugin/audio_libretro/audio_backend_libretro.c
+++ b/mupen64plus-core/src/plugin/audio_libretro/audio_backend_libretro.c
@@ -127,6 +127,10 @@ static void emit_frames(size_t n)
       size_t ret = audio_batch_cb(out, remaining);
       if (ret == 0)
          break;                          /* frontend backpressure; keep the
                                           * remainder rather than stall the
                                           * emulator */
+      /* Guard against frontends that return resampled output frame counts
+       * exceeding the input batch size, which would underflow size_t. */
+      if (ret > remaining)
+         ret = remaining;
       remaining -= ret;
       out       += ret * 2;
    }
