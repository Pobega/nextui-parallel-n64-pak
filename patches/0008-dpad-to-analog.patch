+void libretro_toggle_dpad_to_analog(void)
+{
+    const char *next_value;
+    const char *log_label;
+    struct retro_variable var;
+    struct retro_message msg;
+
+    if (!environ_cb)
+        return;
+
+    if (dpad_to_analog_mode == DPAD_ANALOG_DISABLED)
+    {
+        dpad_to_analog_mode = dpad_last_active_mode;
+        if (dpad_to_analog_mode == DPAD_ANALOG_BOTH)
+        {
+            next_value = "both";
+            log_label = "D-Pad: Control Stick + D-Pad";
+        }
+        else
+        {
+            dpad_to_analog_mode = DPAD_ANALOG_ONLY;
+            next_value = "analog";
+            log_label = "D-Pad: Control Stick";
+        }
+    }
+    else
+    {
+        dpad_last_active_mode = dpad_to_analog_mode;
+        dpad_to_analog_mode = DPAD_ANALOG_DISABLED;
+        next_value = "disabled";
+        log_label = "D-Pad: Digital";
+    }
+
+    var.key = CORE_NAME "-dpad-to-analog";
+    var.value = next_value;
+    environ_cb(RETRO_ENVIRONMENT_SET_VARIABLE, &var);
+    set_variable_visibility();
+
+    msg.msg = log_label;
+    msg.frames = 120;
+    environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE, &msg);
+}
