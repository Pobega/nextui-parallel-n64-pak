+static uint64_t dpad_monotonic_ms(void)
+{
+   struct timespec ts;
+   if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+      return 0;
+   return (uint64_t)ts.tv_sec * 1000u + (uint64_t)(ts.tv_nsec / 1000000L);
+}
+
+static float step_dpad_axis(struct dpad_axis_state *axis, int dir, uint32_t dt_ms)
+{
+   float start;
+   float curved;
+   float mag;
+
+   if (dir == 0)
+   {
+      axis->dir = 0;
+      axis->progress = 0.0f;
+      return 0.0f;
+   }
+   if (dpad_analog_ramp_ms <= 0)
+   {
+      axis->dir = (int8_t)dir;
+      axis->progress = 1.0f;
+      return (float)dir * dpad_analog_max_frac;
+   }
+
+   if (axis->dir != dir)
+   {
+      axis->dir = (int8_t)dir;
+      axis->progress = 0.0f;
+   }
+   else
+   {
+      axis->progress += (float)dt_ms / (float)dpad_analog_ramp_ms;
+      if (axis->progress > 1.0f)
+         axis->progress = 1.0f;
+   }
+
+   start = dpad_analog_max_frac < DPAD_ANALOG_START_FRAC
+         ? dpad_analog_max_frac
+         : DPAD_ANALOG_START_FRAC;
+   curved = axis->progress * axis->progress;
+   mag = start + (dpad_analog_max_frac - start) * curved;
+   return (float)dir * mag;
+}
+
+static int8_t scale_dpad_to_n64_axis(float norm_val)
+{
+   float scaled = norm_val * DPAD_ANALOG_AXIS_MAX;
+   long rounded = (long)(scaled >= 0.0f ? scaled + 0.5f : scaled - 0.5f);
+   if (rounded > DPAD_ANALOG_AXIS_LIMIT)
+      rounded = DPAD_ANALOG_AXIS_LIMIT;
+   else if (rounded < -DPAD_ANALOG_AXIS_LIMIT)
+      rounded = -DPAD_ANALOG_AXIS_LIMIT;
+   return (int8_t)rounded;
+}
+
+static void apply_dpad_to_analog(int Control, BUTTONS *Keys)
+{
+   struct dpad_analog_state *st;
+   uint64_t now_ms;
+   uint32_t dt_ms;
+   int dx;
+   int dy;
+   float vx;
+   float vy;
+
+   if (Control < 0 || Control >= DPAD_ANALOG_MAX_PORTS)
+      return;
+
+   st = &dpad_analog_state[Control];
+   if (dpad_to_analog_mode == DPAD_ANALOG_DISABLED)
+   {
+      memset(st, 0, sizeof(*st));
+      return;
+   }
+
+   now_ms = dpad_monotonic_ms();
+   if (st->last_ms == 0)
+      dt_ms = DPAD_ANALOG_DEFAULT_DT;
+   else if (now_ms >= st->last_ms)
+      dt_ms = (uint32_t)(now_ms - st->last_ms);
+   else
+      dt_ms = DPAD_ANALOG_DEFAULT_DT;
+
+   if (dt_ms > DPAD_ANALOG_MAX_DT)
+      dt_ms = DPAD_ANALOG_MAX_DT;
+   st->last_ms = now_ms;
+
+   dx = PAD_HELD(RETRO_DEVICE_ID_JOYPAD_RIGHT) - PAD_HELD(RETRO_DEVICE_ID_JOYPAD_LEFT);
+   dy = PAD_HELD(RETRO_DEVICE_ID_JOYPAD_UP)    - PAD_HELD(RETRO_DEVICE_ID_JOYPAD_DOWN);
+
+   vx = step_dpad_axis(&st->axis[0], dx, dt_ms);
+   vy = step_dpad_axis(&st->axis[1], dy, dt_ms);
+
+   if (dx != 0)
+      Keys->X_AXIS = scale_dpad_to_n64_axis(vx);
+   if (dy != 0)
+      Keys->Y_AXIS = scale_dpad_to_n64_axis(vy);
+}
